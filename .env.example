# Copie este arquivo para ".env.local" e preencha. NUNCA coloque segredos neste arquivo.

# Banco Postgres (Neon ou outro Postgres) — connection string "pooled"
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo do Auth.js (gerado com: npx auth secret)
AUTH_SECRET=""

# Login com Google (Google Cloud Console > APIs e serviços > Credenciais)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Link mágico por e-mail (Resend). Deixe vazio para desligar.
# Sem domínio verificado no Resend, o e-mail só chega no dono da conta Resend.
AUTH_RESEND_KEY=""
EMAIL_FROM=""

# Fotos (qualquer serviço S3-compatível: Cloudflare R2, Backblaze B2, MinIO…).
# Deixe vazio para o app funcionar sem fotos.
S3_ENDPOINT=""
S3_REGION="auto"  # Backblaze: ex. us-east-005
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Google Places API (New): busca de lugares no cadastro + foto do Google na página do lugar.
# Chave restrita à "Places API (New)". Deixe vazio para desligar.
GOOGLE_PLACES_API_KEY=""

# Senha das contas de teste criadas por scripts/seed-teste.mjs (gerada se vazia)
TEST_USERS_PASSWORD=""
